VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "mock" (default, safe to leave unset) uses the local Seed Copilot dev
# assistant — no network call, nothing else to configure. "api" calls the
# seed-copilot Supabase Edge Function instead, which holds the real
# ANTHROPIC_API_KEY as a server-side secret (see docs/ai-integration.md
# and supabase/functions/seed-copilot/). Never put an AI provider key in a
# VITE_ variable — it would be bundled into the client and publicly
# readable. There is no VITE_AI_BACKEND_URL — the Edge Function is called
# via supabase.functions.invoke() using the existing Supabase client, so
# no separate endpoint URL/secret is needed on the frontend at all.
VITE_AI_MODE=mock
