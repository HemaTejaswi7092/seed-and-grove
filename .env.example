VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "mock" (default, safe to leave unset) uses the local Seed Copilot dev
# assistant. "api" routes through a secure backend endpoint instead — see
# docs/ai-integration.md. Never put an AI provider secret key in a VITE_
# variable; it would be bundled into the client and publicly readable.
VITE_AI_MODE=mock
VITE_AI_BACKEND_URL=
